# Environment variables declared in this file are automatically made available to Prisma and Next.js.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# PostgreSQL Connection String (Supabase, Neon, AWS RDS, or local Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hostel_db?schema=public"

# NextAuth / Auth configuration (if using NextAuth/Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-random-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
